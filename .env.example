# Copy this file to .env and set strong database/admin passwords before starting.
DB_PORT=3306
DB_NAME=inventory_db
DB_USERNAME=inventory
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set true when serving the application over HTTPS.
SESSION_COOKIE_SECURE=false